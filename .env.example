# 已有 Typecho 1.2 数据库。不要把真实口令写进 git。
DATABASE_URL=mysql://user:password@127.0.0.1:3306/typecho
# 表前缀，默认 typecho_
TYPECHO_PREFIX=typecho_
# 对外站点地址，覆盖库里的 siteUrl。用于 RSS 绝对链接。
SITE_URL=https://example.com
LISTEN=0.0.0.0:8080
# 本机 Handsome 主题目录（usr/themes/handsome）。不入库。
HANDSOME_THEME_DIR=./themes/handsome
# Typecho 上传目录，对应 /usr/uploads/
UPLOADS_DIR=./usr/uploads
# 可选，评论头像前缀。国内可改为 https://cravatar.cn/avatar/
# GRAVATAR_PREFIX=https://secure.gravatar.com/avatar/
# STATIC_DIR=./static
